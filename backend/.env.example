# Database Configuration
# Format: mysql+pymysql://user:password@host:port/dbname
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/service_hub_db

# Security
# Generate a strong, random 32+ character string for production
# Example: openssl rand -hex 32
SECRET_KEY=your_super_secret_jwt_key_here

# JWT Expiration in minutes (e.g., 60 = 1 hour, 1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Optional: CORS configuration (comma separated list of allowed origins)
# ALLOWED_ORIGINS=https://your-frontend-domain.com,https://www.your-frontend-domain.com
